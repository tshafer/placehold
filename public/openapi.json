        "/avatar/{seed}": {
            "get": {
                "summary": "Generate identicon avatar",
                "operationId": "avatar.show",
                "tags": [
                    "Images"
                ],
                "parameters": [
                    {
                        "name": "seed",
                        "in": "path",
                        "description": "Seed string for deterministic avatar",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "alice"
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "description": "Size in pixels (default 200)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "200"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "image/svg+xml": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded"
                    }
                }
            }
        },
