{
    "openapi": "3.0.3",
    "info": {
        "title": "placehold.cloud API",
        "description": "Free placeholder content API \u2014 images, text, data, documents, and more.",
        "version": "1.5.0",
        "contact": {
            "url": "https://placehold.cloud/contact"
        }
    },
    "servers": [
        {
            "url": "https://placehold.cloud",
            "description": "Production"
        }
    ],
    "tags": [
        {
            "name": "Images",
            "description": "Image and visual generators"
        },
        {
            "name": "Data",
            "description": "Structured data and text APIs"
        },
        {
            "name": "Documents",
            "description": "PDF, CSV, Markdown generators"
        },
        {
            "name": "Fun",
            "description": "Quotes, jokes, recipes, weather"
